{{<base.mustache}}
{{$content}}
  <div id="dashboard" class="dashboard" data-signals__ifmissing="{_observedUsageRevision: {{revision}}, _htmlPending: false, _streamPending: false, _authExpired: false, _retrying: false}" data-signals="{_renderedUsageRevision: {{revision}}, _retrying: false}" data-init="!$_authExpired && !$_streamPending && (($_streamPending = true) && @get('/api/stream?revision=' + $_observedUsageRevision, {retry: 'never'}).finally(() => $_streamPending = false).catch(() => $_retrying = true))" data-on-interval__duration.6s="!$_authExpired && ($_observedUsageRevision > $_renderedUsageRevision ? (!$_htmlPending && (($_htmlPending = true) && @get(window.location.pathname, {retry: 'never'}).finally(() => $_htmlPending = false).catch(() => $_retrying = true))) : (!$_streamPending && (($_streamPending = true) && @get('/api/stream?revision=' + $_observedUsageRevision, {retry: 'never'}).finally(() => $_streamPending = false).catch(() => $_retrying = true))))" data-effect="$_observedUsageRevision > $_renderedUsageRevision && @peek(() => document.dispatchEvent(new CustomEvent('toktrak-dashboard-revision')))" data-on:toktrak-dashboard-revision__document="!$_authExpired && $_observedUsageRevision > $_renderedUsageRevision && !$_htmlPending && (($_htmlPending = true) && @get(window.location.pathname, {retry: 'never'}).finally(() => $_htmlPending = false).catch(() => $_retrying = true))" data-on:datastar-fetch__document="evt.detail.el.id === 'dashboard' && evt.detail.argsRaw.status === '401' ? (($_authExpired = true) && ($_retrying = false)) : (evt.detail.el.id === 'dashboard' && (evt.detail.type === 'retrying' || /^5\d\d$/u.test(evt.detail.argsRaw.status)) ? ($_retrying = true) : (evt.detail.el.id === 'dashboard' && evt.detail.type === 'datastar-patch-signals' && $_observedUsageRevision === $_renderedUsageRevision && ($_retrying = false)))">
    <p id="dashboard-refresh-state" data-show="$_authExpired || $_retrying" role="status"><span data-show="$_authExpired">Dashboard updates paused. Refresh to sign in again.</span><span data-show="!$_authExpired && $_retrying">Dashboard updates delayed. Retrying shortly.</span></p>
    <header class="page-heading">
      <h1>Visualizations</h1>
    </header>
{{#dashboard.degraded}}
    <aside class="warning" role="alert"><strong>Read-only mode</strong> Showing last stored usage.</aside>
{{/dashboard.degraded}}
    <div class="narrative">
      <section class="viz-section viz-hero" aria-labelledby="trend-heading">
        <div>
          <h2 id="trend-heading">Daily projected cost</h2>
          <p>Recent daily totals across the team. USD remains canonical; the selected currency is an estimate.</p>
        </div>
        <figure class="trend-chart">
          <svg class="chart-rule" viewBox="0 0 100 2" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 1H100"/></svg>
          <figcaption class="sr-only">Daily cost trend shown as proportional text bars.</figcaption>
{{#dashboard.trends}}
          <div class="trend-row">
            <time datetime="{{date}}">{{humanReadableDate}}</time>
            <span class="bar" aria-hidden="true">{{bar}}</span>
            <strong>{{cost}}</strong>
            <small>{{tokens}} tokens</small>
          </div>
{{/dashboard.trends}}
{{^dashboard.trends}}
          <p class="empty">No daily usage yet.</p>
{{/dashboard.trends}}
        </figure>
      </section>

      <section class="viz-section" aria-labelledby="tokens-heading">
        <div>
          <h2 id="tokens-heading">Where tokens go</h2>
        </div>
        <div class="metric-list">
{{#dashboard.tokenTypes}}
          <div class="metric-row"><strong>{{label}}</strong><span class="bar" aria-hidden="true">{{bar}}</span><span>{{value}}</span><small>{{detail}}</small></div>
{{/dashboard.tokenTypes}}
        </div>
      </section>

      <section class="viz-section" aria-labelledby="rhythm-heading">
        <div>
          <h2 id="rhythm-heading">Usage rhythm by UTC weekday</h2>
        </div>
        <div class="rhythm-grid" role="list">
{{#dashboard.rhythm}}
          <div role="listitem"><strong>{{label}}</strong><span class="heat" aria-hidden="true">{{bar}}</span><span>{{value}}</span><small>{{detail}}</small></div>
{{/dashboard.rhythm}}
        </div>
      </section>

      <section class="viz-section split" aria-labelledby="mix-heading">
        <div>
          <h2 id="mix-heading">Model and harness mix</h2>
        </div>
        <article>
          <h3>Models</h3>
          <div class="metric-list compact">
{{#dashboard.models}}
            <div class="metric-row"><strong>{{label}}</strong><span class="bar" aria-hidden="true">{{bar}}</span><span>{{value}}</span><small>{{detail}}</small></div>
{{/dashboard.models}}
          </div>
        </article>
        <article>
          <h3>Sources</h3>
          <div class="metric-list compact">
{{#dashboard.sources}}
            <div class="metric-row"><strong>{{label}}</strong><span class="bar" aria-hidden="true">{{bar}}</span><span>{{value}}</span><small>{{detail}}</small></div>
{{/dashboard.sources}}
          </div>
        </article>
      </section>

      <section class="viz-section" aria-labelledby="streams-heading">
        <div>
          <h2 id="streams-heading">Individual streams, shared context</h2>
        </div>
        <ol class="leaderboard streams">
{{#dashboard.userStreams}}
          <li><span class="avatar {{colorClass}}" aria-hidden="true">{{initials}}</span><span class="person"><strong>{{name}}</strong><span class="bar" aria-hidden="true">{{bar}}</span></span><span class="values"><strong>{{cost}}</strong><small>{{tokens}}</small></span></li>
{{/dashboard.userStreams}}
        </ol>
        <div class="table-wrap">
          <table>
            <caption>Largest individual daily cost rows</caption>
            <thead><tr><th>Date</th><th>User</th><th>Cost</th><th>Tokens</th></tr></thead>
            <tbody>
{{#dashboard.spikes}}
              <tr><td><time datetime="{{date}}">{{humanReadableDate}}</time></td><td>{{user}}</td><td>{{cost}}</td><td>{{tokens}}</td></tr>
{{/dashboard.spikes}}
            </tbody>
          </table>
        </div>
      </section>

      <section class="viz-section" aria-labelledby="details-heading">
        <div>
          <h2 id="details-heading">Costliest sessions</h2>
          <p>Harness is always shown. Project appears when ccusage reports it.</p>
        </div>
        <div class="table-wrap">
          <table>
            <caption>Top sessions by projected cost</caption>
            <thead><tr><th>User</th><th>Source</th><th>Project</th><th>Models</th><th>Cost</th><th>Tokens</th><th>Last activity</th></tr></thead>
            <tbody>
{{#dashboard.sessions}}
              <tr><td>{{user}}</td><td>{{source}}</td><td>{{project}}</td><td>{{models}}</td><td>{{cost}}</td><td>{{tokens}}</td><td>{{lastActivity}}</td></tr>
{{/dashboard.sessions}}
            </tbody>
          </table>
        </div>
      </section>

      <section class="viz-section" aria-labelledby="blocks-heading">
        <div>
          <h2 id="blocks-heading">Recent coding blocks</h2>
        </div>
        <div class="table-wrap">
          <table>
            <caption>Recent five-hour usage blocks</caption>
            <thead><tr><th>Start UTC</th><th>Models</th><th>Cost</th><th>Tokens</th><th>Entries</th></tr></thead>
            <tbody>
{{#dashboard.blocks}}
              <tr><td>{{start}}</td><td>{{models}}</td><td>{{cost}}</td><td>{{tokens}}</td><td>{{entries}}</td></tr>
{{/dashboard.blocks}}
            </tbody>
          </table>
        </div>
      </section>
    </div>
    <footer class="page-footer"><p>Totals are projected subscription-equivalent usage, not invoices or performance measures.</p><a href="/scope">Read data scope →</a></footer>
  </div>
{{/content}}
{{/base.mustache}}
