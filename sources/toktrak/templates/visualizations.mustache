{{<base.mustache}}
{{$content}}
  <div id="dashboard" class="dashboard" data-signals__ifmissing="{_observedUsageRevision: {{revision}}, _htmlPending: false, _streamPending: false, _authExpired: false, _retrying: false}" data-signals="{_renderedUsageRevision: {{revision}}, _retrying: false}" data-init="!$_authExpired && !$_streamPending && (($_streamPending = true) && @get('/api/stream?revision=' + $_observedUsageRevision, {retry: 'never'}).finally(() => $_streamPending = false).catch(() => $_retrying = true))" data-on-interval__duration.6s="!$_authExpired && ($_observedUsageRevision > $_renderedUsageRevision ? (!$_htmlPending && (($_htmlPending = true) && @get(window.location.pathname + window.location.search, {retry: 'never'}).finally(() => $_htmlPending = false).catch(() => $_retrying = true))) : (!$_streamPending && (($_streamPending = true) && @get('/api/stream?revision=' + $_observedUsageRevision, {retry: 'never'}).finally(() => $_streamPending = false).catch(() => $_retrying = true))))" data-effect="$_observedUsageRevision > $_renderedUsageRevision && @peek(() => document.dispatchEvent(new CustomEvent('toktrak-dashboard-revision')))" data-on:toktrak-dashboard-revision__document="!$_authExpired && $_observedUsageRevision > $_renderedUsageRevision && !$_htmlPending && (($_htmlPending = true) && @get(window.location.pathname + window.location.search, {retry: 'never'}).finally(() => $_htmlPending = false).catch(() => $_retrying = true))" data-on:datastar-fetch__document="evt.detail.el.id === 'dashboard' && evt.detail.argsRaw.status === '401' ? (($_authExpired = true) && ($_retrying = false)) : (evt.detail.el.id === 'dashboard' && (evt.detail.type === 'retrying' || /^5\d\d$/u.test(evt.detail.argsRaw.status)) ? ($_retrying = true) : (evt.detail.el.id === 'dashboard' && evt.detail.type === 'datastar-patch-signals' && $_observedUsageRevision === $_renderedUsageRevision && ($_retrying = false)))">
    <p id="dashboard-refresh-state" data-show="$_authExpired || $_retrying" role="status"><span data-show="$_authExpired">Dashboard updates paused. Refresh to sign in again.</span><span data-show="!$_authExpired && $_retrying">Dashboard updates delayed. Retrying shortly.</span></p>
    <header class="page-heading">
      <h1>Visualizations</h1>
    </header>
{{#dashboard.degraded}}
    <aside class="warning" role="alert"><strong>Read-only mode</strong> Showing last stored usage.</aside>
{{/dashboard.degraded}}
{{#charts}}
    <section class="usage-range" aria-labelledby="range-heading">
      <div>
        <h2 id="range-heading" class="eyebrow">Range</h2>
        <p class="range-label"><strong>{{rangeLabel}}</strong> <span>{{calendarDays}} days · applies to every chart below</span></p>
      </div>
      <nav class="segmented" aria-label="Date range">
{{#rangeOptions}}
{{#current}}
        <a href="{{url}}" aria-current="page">{{label}}</a>
{{/current}}
{{^current}}
        <a href="{{url}}">{{label}}</a>
{{/current}}
{{/rangeOptions}}
      </nav>
      <form class="range-form" method="get" action="/visualizations">
        <input type="hidden" name="range" value="custom">
        <label>From <input type="date" name="from" value="{{rangeFrom}}" required></label>
        <label>To <input type="date" name="to" value="{{rangeTo}}" required></label>
        <button type="submit">Apply</button>
      </form>
    </section>
    <dl class="chart-kpis">
{{#kpis}}
      <div><dt>{{label}}</dt><dd data-usd="{{usd}}">{{value}}</dd></div>
{{/kpis}}
    </dl>
    <div class="chart-grid">
{{#dailyCost}}
      <article class="chart-card chart-card-wide" aria-labelledby="daily-cost-heading">
        <h2 id="daily-cost-heading">Cost per {{bucketName}} by tool</h2>
        <p>{{description}}</p>
        <svg class="chart" viewBox="0 0 {{width}} {{height}}" role="img" aria-labelledby="daily-cost-heading">
{{#yTicks}}
          <line class="chart-grid-line" x1="{{x1}}" y1="{{y}}" x2="{{x2}}" y2="{{y}}"/>
          <text class="chart-axis" x="{{labelX}}" y="{{labelY}}" text-anchor="end">{{label}}</text>
{{/yTicks}}
{{#columns}}
          <rect class="{{seriesClass}}" x="{{x}}" y="{{y}}" width="{{width}}" height="{{height}}" data-usd="{{usd}}"><title>{{title}}</title></rect>
{{/columns}}
{{#averages}}
          <path class="chart-average" d="{{path}}"><title>{{label}}</title></path>
{{/averages}}
{{#xLabels}}
          <text class="chart-axis" x="{{x}}" y="{{y}}" text-anchor="middle">{{label}}</text>
{{/xLabels}}
        </svg>
        <ul class="chart-legend">
{{#legend}}
          <li data-usd="{{usd}}"><span class="swatch {{seriesClass}}" aria-hidden="true"></span>{{label}} <strong>{{value}}</strong></li>
{{/legend}}
{{#averages}}
          <li><span class="swatch swatch-line" aria-hidden="true"></span>{{label}}</li>
{{/averages}}
        </ul>
        <dl class="chart-stats">
{{#stats}}
          <div><dt>{{label}}</dt><dd data-usd="{{usd}}">{{value}}</dd></div>
{{/stats}}
        </dl>
        <details class="chart-data">
          <summary>Data table</summary>
          <div class="table-wrap">
            <table>
              <thead><tr><th scope="col">Period</th><th scope="col">Estimated cost</th></tr></thead>
              <tbody>
{{#rows}}
                <tr data-usd="{{usd}}"><td>{{bucket}}</td><td>{{value}}</td></tr>
{{/rows}}
              </tbody>
            </table>
          </div>
        </details>
        <p class="chart-note">Tool totals add up to the estimated cost above. Costs without a reported tool appear as Not reported.</p>
      </article>
{{/dailyCost}}
    </div>
{{/charts}}
{{#insights}}
    <div class="chart-grid">
      <article class="chart-card" aria-labelledby="cumulative-heading">
        <h2 id="cumulative-heading">Cumulative cost</h2>
        <p>Running total across the range. Dashed: an even pace that reaches the same total by today.</p>
{{#cumulative}}
        <svg class="chart" viewBox="0 0 {{width}} {{height}}" role="img" aria-labelledby="cumulative-heading">
{{#yTicks}}
          <line class="chart-grid-line" x1="{{x1}}" y1="{{y}}" x2="{{x2}}" y2="{{y}}"/>
          <text class="chart-axis" x="{{labelX}}" y="{{labelY}}" text-anchor="end">{{label}}</text>
{{/yTicks}}
{{#lines}}
          <path class="{{lineClass}}" d="{{path}}"><title>{{label}}</title></path>
{{/lines}}
{{#xLabels}}
          <text class="chart-axis" x="{{x}}" y="{{y}}" text-anchor="middle">{{label}}</text>
{{/xLabels}}
        </svg>
        <ul class="chart-legend">
{{#lines}}
          <li><span class="swatch swatch-line {{lineClass}}" aria-hidden="true"></span>{{label}}</li>
{{/lines}}
        </ul>
        <dl class="chart-stats">
{{#stats}}
          <div><dt>{{label}}</dt><dd data-usd="{{usd}}">{{value}}</dd></div>
{{/stats}}
        </dl>
{{/cumulative}}
        <p class="chart-note">Above the dashed line, spending ran ahead of the average pace.</p>
      </article>
{{#activePeople}}
      <article class="chart-card" aria-labelledby="people-active-heading">
        <h2 id="people-active-heading">People active per {{bucketName}}</h2>
        <p>{{description}} An adoption signal, not a productivity measure.</p>
        <svg class="chart" viewBox="0 0 {{width}} {{height}}" role="img" aria-labelledby="people-active-heading">
{{#yTicks}}
          <line class="chart-grid-line" x1="{{x1}}" y1="{{y}}" x2="{{x2}}" y2="{{y}}"/>
          <text class="chart-axis" x="{{labelX}}" y="{{labelY}}" text-anchor="end">{{label}}</text>
{{/yTicks}}
{{#columns}}
          <rect class="{{seriesClass}}" x="{{x}}" y="{{y}}" width="{{width}}" height="{{height}}"><title>{{title}}</title></rect>
{{/columns}}
{{#xLabels}}
          <text class="chart-axis" x="{{x}}" y="{{y}}" text-anchor="middle">{{label}}</text>
{{/xLabels}}
        </svg>
        <dl class="chart-stats">
{{#stats}}
          <div><dt>{{label}}</dt><dd data-usd="{{usd}}">{{value}}</dd></div>
{{/stats}}
        </dl>
      </article>
{{/activePeople}}
      <article class="chart-card" aria-labelledby="sizes-heading">
        <h2 id="sizes-heading">How big is a person-day?</h2>
        <p>Each person-day, one person on one day with usage, falls into a cost range. Left: how often. Right: how much of the cost it adds.</p>
{{#personDaySizes}}
        <div class="bar-list" role="table" aria-labelledby="sizes-heading">
          <div class="bar-list-head" role="row">{{#headings}}<span role="columnheader">{{.}}</span>{{/headings}}</div>
{{#rows}}
          <div class="bar-list-row" role="row" data-usd="{{usd}}"><span role="cell">{{label}}</span><span role="cell"><svg class="bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="bar-track" width="100" height="8"/><rect class="bar-fill" width="{{firstWidth}}" height="8"/></svg><small>{{firstValue}}</small></span>{{#second}}<span role="cell"><svg class="bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="bar-track" width="100" height="8"/><rect class="bar-fill" width="{{width}}" height="8"/></svg><small>{{value}}</small></span>{{/second}}</div>
{{/rows}}
        </div>
        <dl class="chart-stats">
{{#stats}}
          <div><dt>{{label}}</dt><dd data-usd="{{usd}}">{{value}}</dd></div>
{{/stats}}
        </dl>
{{/personDaySizes}}
        <p class="chart-note">A mean far above the median means a few large days drive the total.</p>
      </article>
      <article class="chart-card" aria-labelledby="concentration-heading">
        <h2 id="concentration-heading">Concentration</h2>
        <p>Sort person-days from most to least expensive. Each point shows how much of the cost the costliest x% cause. Dashed: perfectly even.</p>
{{#personDayConcentration}}
        <svg class="chart" viewBox="0 0 {{width}} {{height}}" role="img" aria-labelledby="concentration-heading">
{{#yTicks}}
          <line class="chart-grid-line" x1="{{x1}}" y1="{{y}}" x2="{{x2}}" y2="{{y}}"/>
          <text class="chart-axis" x="{{labelX}}" y="{{labelY}}" text-anchor="end">{{label}}</text>
{{/yTicks}}
{{#lines}}
          <path class="{{lineClass}}" d="{{path}}"><title>{{label}}</title></path>
{{/lines}}
{{#xLabels}}
          <text class="chart-axis" x="{{x}}" y="{{y}}" text-anchor="middle">{{label}}</text>
{{/xLabels}}
        </svg>
        <ul class="chart-legend">
{{#lines}}
          <li><span class="swatch swatch-line {{lineClass}}" aria-hidden="true"></span>{{label}}</li>
{{/lines}}
        </ul>
        <dl class="chart-stats">
{{#stats}}
          <div><dt>{{label}}</dt><dd data-usd="{{usd}}">{{value}}</dd></div>
{{/stats}}
        </dl>
{{/personDayConcentration}}
        <p class="chart-note">A steeper curve means the spend is concentrated in fewer days.</p>
      </article>
{{#people}}
      <article class="chart-card chart-card-wide" aria-labelledby="per-person-heading">
        <h2 id="per-person-heading">Per person</h2>
        <p>Cost per person in this range. Trends share one log scale: each faint line is 10× the one below ($1, $10, $100…), so small and large spenders stay visible. Shares add up to 100%; the typical day is the median over days with usage.</p>
        <div class="table-wrap">
          <table class="people-table">
            <thead><tr><th scope="col">Person</th><th scope="col">Trend</th><th scope="col">Total</th><th scope="col">Share</th><th scope="col">Active days</th><th scope="col">Typical day</th><th scope="col">Per calendar day</th></tr></thead>
            <tbody>
{{#rows}}
              <tr><th scope="row">{{name}}</th><td><svg class="spark" viewBox="0 0 120 24" preserveAspectRatio="none" role="img" aria-label="Cost trend for {{name}}">{{#grid}}<line class="spark-grid" x1="0" y1="{{y}}" x2="120" y2="{{y}}"><title>{{label}}</title></line>{{/grid}}{{#spark}}<rect class="{{seriesClass}}" x="{{x}}" y="{{y}}" width="{{width}}" height="{{height}}"><title>{{title}}</title></rect>{{/spark}}</svg></td><td data-usd="{{usd}}">{{total}}</td><td>{{share}}</td><td>{{activeDays}}</td><td>{{typical}}</td><td>{{perDay}}</td></tr>
{{/rows}}
            </tbody>
          </table>
        </div>
        <dl class="chart-stats">
{{#stats}}
          <div><dt>{{label}}</dt><dd data-usd="{{usd}}">{{value}}</dd></div>
{{/stats}}
        </dl>
      </article>
{{/people}}
{{#modelMix}}
      <article class="chart-card chart-card-wide" aria-labelledby="model-mix-heading">
        <h2 id="model-mix-heading">Model mix per {{periodName}}</h2>
        <p>Share of each {{periodName}}'s cost per model. The top five models are shown; the rest are grouped.</p>
        <div class="stacked-rows">
{{#rows}}
          <div class="stacked-row" data-usd="{{usd}}"><span>{{period}}</span><svg viewBox="0 0 100 10" preserveAspectRatio="none" role="img" aria-label="Model mix for {{period}}">{{#segments}}<rect class="{{seriesClass}}" x="{{x}}" y="0" width="{{width}}" height="10" data-usd="{{usd}}"><title>{{title}}</title></rect>{{/segments}}</svg></div>
{{/rows}}
        </div>
        <ul class="chart-legend chart-legend-models">
{{#legend}}
          <li data-model-usd="{{usd}}"><span class="swatch {{seriesClass}}" aria-hidden="true"></span>{{label}} <strong>{{value}}</strong></li>
{{/legend}}
        </ul>
        <dl class="chart-stats">
{{#stats}}
          <div><dt>{{label}}</dt><dd data-usd="{{usd}}">{{value}}</dd></div>
{{/stats}}
        </dl>
        <p class="chart-note">Model names are shown as each tool reports them. Costs without a reported model appear as Not reported.</p>
      </article>
{{/modelMix}}
      <article class="chart-card" aria-labelledby="token-price-heading">
        <h2 id="token-price-heading">Cost per million tokens</h2>
        <p>Model cost divided by all its tokens, including cache reads. Shows how expensive each model was in practice.</p>
{{#tokenPrice}}
        <div class="bar-list" role="table" aria-labelledby="token-price-heading">
          <div class="bar-list-head" role="row">{{#headings}}<span role="columnheader">{{.}}</span>{{/headings}}</div>
{{#rows}}
          <div class="bar-list-row" role="row" data-usd="{{usd}}"><span role="cell">{{label}}</span><span role="cell"><svg class="bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="bar-track" width="100" height="8"/><rect class="bar-fill" width="{{firstWidth}}" height="8"/></svg><small>{{firstValue}}</small></span>{{#second}}<span role="cell"><svg class="bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="bar-track" width="100" height="8"/><rect class="bar-fill" width="{{width}}" height="8"/></svg><small>{{value}}</small></span>{{/second}}</div>
{{/rows}}
        </div>
        <dl class="chart-stats">
{{#stats}}
          <div><dt>{{label}}</dt><dd data-usd="{{usd}}">{{value}}</dd></div>
{{/stats}}
        </dl>
{{/tokenPrice}}
        <p class="chart-note">Low numbers usually mean heavy cache reuse, not a cheap model. Top eight models by cost.</p>
      </article>
      <article class="chart-card" aria-labelledby="cache-heading">
        <h2 id="cache-heading">Cache reuse</h2>
        <p>Share of input-side tokens read from cache per period. High values mean long agent sessions reusing context.</p>
{{#cacheReuse}}
        <svg class="chart" viewBox="0 0 {{width}} {{height}}" role="img" aria-labelledby="cache-heading">
{{#yTicks}}
          <line class="chart-grid-line" x1="{{x1}}" y1="{{y}}" x2="{{x2}}" y2="{{y}}"/>
          <text class="chart-axis" x="{{labelX}}" y="{{labelY}}" text-anchor="end">{{label}}</text>
{{/yTicks}}
{{#lines}}
          <path class="{{lineClass}}" d="{{path}}"><title>{{label}}</title></path>
{{/lines}}
{{#xLabels}}
          <text class="chart-axis" x="{{x}}" y="{{y}}" text-anchor="middle">{{label}}</text>
{{/xLabels}}
        </svg>
        <ul class="chart-legend">
{{#lines}}
          <li><span class="swatch swatch-line {{lineClass}}" aria-hidden="true"></span>{{label}}</li>
{{/lines}}
        </ul>
        <dl class="chart-stats">
{{#stats}}
          <div><dt>{{label}}</dt><dd data-usd="{{usd}}">{{value}}</dd></div>
{{/stats}}
        </dl>
{{/cacheReuse}}
        <p class="chart-note">Gaps are periods without usage.</p>
      </article>
    </div>
{{#sessions}}
    <section class="session-insights" aria-labelledby="sessions-heading">
      <h2 id="sessions-heading" class="legacy-heading">Sessions</h2>
{{#warning}}
      <aside class="warning" role="note"><strong>Session data incomplete</strong> {{coverage}}</aside>
{{/warning}}
{{^warning}}
      <p class="coverage">{{coverage}}</p>
{{/warning}}
      <dl class="chart-stats">
{{#stats}}
        <div><dt>{{label}}</dt><dd data-session-usd="{{usd}}">{{value}}</dd></div>
{{/stats}}
      </dl>
      <div class="chart-grid">
      <article class="chart-card" aria-labelledby="session-sizes-heading">
        <h2 id="session-sizes-heading">Session sizes</h2>
        <p>Coding sessions grouped by cost. Left: share of sessions. Right: share of session cost.</p>
{{#sizes}}
        <div class="bar-list" role="table" aria-labelledby="session-sizes-heading">
          <div class="bar-list-head" role="row">{{#headings}}<span role="columnheader">{{.}}</span>{{/headings}}</div>
{{#rows}}
          <div class="bar-list-row" role="row" data-usd="{{usd}}"><span role="cell">{{label}}</span><span role="cell"><svg class="bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="bar-track" width="100" height="8"/><rect class="bar-fill" width="{{firstWidth}}" height="8"/></svg><small>{{firstValue}}</small></span>{{#second}}<span role="cell"><svg class="bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="bar-track" width="100" height="8"/><rect class="bar-fill" width="{{width}}" height="8"/></svg><small>{{value}}</small></span>{{/second}}</div>
{{/rows}}
        </div>
        <dl class="chart-stats">
{{#stats}}
          <div><dt>{{label}}</dt><dd data-usd="{{usd}}">{{value}}</dd></div>
{{/stats}}
        </dl>
{{/sizes}}
        <p class="chart-note">Sessions count on the day of their last activity.</p>
      </article>
      <article class="chart-card" aria-labelledby="session-concentration-heading">
        <h2 id="session-concentration-heading">Session concentration</h2>
        <p>Sort sessions from most to least expensive. Each point shows how much of the session cost the costliest x% cause.</p>
{{#concentration}}
        <svg class="chart" viewBox="0 0 {{width}} {{height}}" role="img" aria-labelledby="session-concentration-heading">
{{#yTicks}}
          <line class="chart-grid-line" x1="{{x1}}" y1="{{y}}" x2="{{x2}}" y2="{{y}}"/>
          <text class="chart-axis" x="{{labelX}}" y="{{labelY}}" text-anchor="end">{{label}}</text>
{{/yTicks}}
{{#lines}}
          <path class="{{lineClass}}" d="{{path}}"><title>{{label}}</title></path>
{{/lines}}
{{#xLabels}}
          <text class="chart-axis" x="{{x}}" y="{{y}}" text-anchor="middle">{{label}}</text>
{{/xLabels}}
        </svg>
        <ul class="chart-legend">
{{#lines}}
          <li><span class="swatch swatch-line {{lineClass}}" aria-hidden="true"></span>{{label}}</li>
{{/lines}}
        </ul>
        <dl class="chart-stats">
{{#stats}}
          <div><dt>{{label}}</dt><dd data-usd="{{usd}}">{{value}}</dd></div>
{{/stats}}
        </dl>
{{/concentration}}
        <p class="chart-note">Most sessions are cheap; a few long ones dominate.</p>
      </article>
{{#rhythm}}
        <article class="chart-card chart-card-wide" aria-labelledby="rhythm-hours-heading">
          <h2 id="rhythm-hours-heading">When cost happens</h2>
          <p>Session cost by weekday and hour of each session's last activity, in each person's own time zone. Darker means more cost.</p>
          <div class="heatmap-wrap" tabindex="0">
          <svg class="chart" viewBox="0 0 {{width}} {{height}}" role="img" aria-labelledby="rhythm-hours-heading">
{{#cells}}
            <rect class="heat-cell" x="{{x}}" y="{{y}}" width="{{width}}" height="{{height}}" fill-opacity="{{opacity}}"><title>{{title}}</title></rect>
{{/cells}}
{{#rowLabels}}
            <text class="chart-axis" x="{{x}}" y="{{y}}">{{label}}</text>
{{/rowLabels}}
{{#columnLabels}}
            <text class="chart-axis" x="{{x}}" y="{{y}}" text-anchor="middle">{{label}}</text>
{{/columnLabels}}
          </svg>
          </div>
          <dl class="chart-stats">
  {{#stats}}
            <div><dt>{{label}}</dt><dd data-usd="{{usd}}">{{value}}</dd></div>
  {{/stats}}
          </dl>
          <p class="chart-note">Long sessions place all their cost in their final hour.</p>
        </article>
{{/rhythm}}
      </div>
    </section>
{{/sessions}}
{{/insights}}
    <h2 class="legacy-heading">All reported dates · older views</h2>
    <div class="narrative">
      <section class="viz-section viz-hero" aria-labelledby="trend-heading">
        <div>
          <h2 id="trend-heading">Daily projected cost</h2>
          <p>Recent daily totals across the team. USD remains canonical; the selected currency is an estimate.</p>
        </div>
        <figure class="trend-chart">
          <svg class="chart-rule" viewBox="0 0 100 2" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 1H100"/></svg>
          <figcaption class="sr-only">Daily cost trend shown as proportional bars.</figcaption>
{{#dashboard.trends}}
          <div class="trend-row">
            <time datetime="{{date}}">{{humanReadableDate}}</time>
            <svg class="bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="bar-track" width="100" height="8"/><rect class="bar-fill" width="{{bar}}" height="8"/></svg>
            <strong>{{cost}}</strong>
            <small>{{tokens}} tokens</small>
          </div>
{{/dashboard.trends}}
{{^dashboard.trends}}
          <p class="empty">No daily usage yet.</p>
{{/dashboard.trends}}
        </figure>
      </section>

      <section class="viz-section" aria-labelledby="tokens-heading">
        <div>
          <h2 id="tokens-heading">Where tokens go</h2>
        </div>
        <div class="metric-list">
{{#dashboard.tokenTypes}}
          <div class="metric-row"><strong>{{label}}</strong><svg class="bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="bar-track" width="100" height="8"/><rect class="bar-fill" width="{{bar}}" height="8"/></svg><span>{{value}}</span><small>{{detail}}</small></div>
{{/dashboard.tokenTypes}}
        </div>
      </section>

      <section class="viz-section" aria-labelledby="rhythm-heading">
        <div>
          <h2 id="rhythm-heading">Usage by day of the week</h2>
          <p>Adds up estimated cost and tokens across all reported dates and tools. Weekdays use the dates reported by each tracker. The longest bar marks the highest total cost.</p>
        </div>
        <div class="rhythm-grid" role="list">
{{#dashboard.rhythm}}
          <div role="listitem"><strong>{{label}}</strong><svg class="bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="bar-track" width="100" height="8"/><rect class="bar-fill" width="{{bar}}" height="8"/></svg><span>{{value}}</span><small>{{detail}}</small></div>
{{/dashboard.rhythm}}
        </div>
      </section>

      <section class="viz-section split" aria-labelledby="mix-heading">
        <div>
          <h2 id="mix-heading">Model and harness mix</h2>
        </div>
        <article>
          <h3>Models</h3>
          <div class="metric-list compact">
{{#dashboard.models}}
            <div class="metric-row"><strong>{{label}}</strong><svg class="bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="bar-track" width="100" height="8"/><rect class="bar-fill" width="{{bar}}" height="8"/></svg><span>{{value}}</span><small>{{detail}}</small></div>
{{/dashboard.models}}
          </div>
        </article>
        <article>
          <h3>Sources</h3>
          <div class="metric-list compact">
{{#dashboard.sources}}
            <div class="metric-row"><strong>{{label}}</strong><svg class="bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="bar-track" width="100" height="8"/><rect class="bar-fill" width="{{bar}}" height="8"/></svg><span>{{value}}</span><small>{{detail}}</small></div>
{{/dashboard.sources}}
          </div>
        </article>
      </section>

      <section class="viz-section" aria-labelledby="streams-heading">
        <div>
          <h2 id="streams-heading">Individual streams, shared context</h2>
        </div>
        <ol class="leaderboard streams">
{{#dashboard.userStreams}}
          <li><span class="avatar {{colorClass}}" aria-hidden="true">{{initials}}</span><span class="person"><strong>{{name}}</strong><svg class="bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="bar-track" width="100" height="8"/><rect class="bar-fill" width="{{bar}}" height="8"/></svg></span><span class="values"><strong>{{cost}}</strong><small>{{tokens}}</small></span></li>
{{/dashboard.userStreams}}
        </ol>
        <div class="table-wrap">
          <table>
            <caption>Largest individual daily cost rows</caption>
            <thead><tr><th>Date</th><th>User</th><th>Cost</th><th>Tokens</th></tr></thead>
            <tbody>
{{#dashboard.spikes}}
              <tr><td><time datetime="{{date}}">{{humanReadableDate}}</time></td><td>{{user}}</td><td>{{cost}}</td><td>{{tokens}}</td></tr>
{{/dashboard.spikes}}
            </tbody>
          </table>
        </div>
      </section>

      <section class="viz-section" aria-labelledby="details-heading">
        <div>
          <h2 id="details-heading">Costliest sessions</h2>
          <p>Harness is always shown. Project appears when ccusage reports it.</p>
        </div>
        <div class="table-wrap">
          <table>
            <caption>Top sessions by projected cost</caption>
            <thead><tr><th>User</th><th>Source</th><th>Project</th><th>Models</th><th>Cost</th><th>Tokens</th><th>Last activity</th></tr></thead>
            <tbody>
{{#dashboard.sessions}}
              <tr><td>{{user}}</td><td>{{source}}</td><td>{{project}}</td><td>{{models}}</td><td>{{cost}}</td><td>{{tokens}}</td><td>{{lastActivity}}</td></tr>
{{/dashboard.sessions}}
            </tbody>
          </table>
        </div>
      </section>

      <section class="viz-section" aria-labelledby="blocks-heading">
        <div>
          <h2 id="blocks-heading">Recent usage windows</h2>
          <p>These five-hour windows come from ccusage. They show recorded usage, not time spent coding.</p>
        </div>
        <div class="table-wrap">
          <table>
            <caption>Up to 20 windows, newest first</caption>
            <thead><tr><th>Start UTC</th><th>Models</th><th>Cost</th><th>Tokens</th><th>Entries</th></tr></thead>
            <tbody>
{{#dashboard.blocks}}
              <tr><td>{{start}}</td><td>{{models}}</td><td>{{cost}}</td><td>{{tokens}}</td><td>{{entries}}</td></tr>
{{/dashboard.blocks}}
            </tbody>
          </table>
        </div>
      </section>
    </div>
    <footer class="page-footer"><p>Totals are projected subscription-equivalent usage, not invoices or performance measures.</p><a href="/scope">Read data scope →</a></footer>
  </div>
{{/content}}
{{/base.mustache}}
