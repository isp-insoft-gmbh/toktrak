{{<base.mustache}}
{{$content}}
  <div id="dashboard" class="dashboard" data-signals__ifmissing="{_observedUsageRevision: {{revision}}, _htmlPending: false, _streamPending: false, _authExpired: false, _retrying: false}" data-signals="{_renderedUsageRevision: {{revision}}, _retrying: false}" data-init="!$_authExpired && !$_streamPending && (($_streamPending = true) && @get('/api/stream?revision=' + $_observedUsageRevision, {retry: 'never'}).finally(() => $_streamPending = false).catch(() => $_retrying = true))" data-on-interval__duration.6s="!$_authExpired && ($_observedUsageRevision > $_renderedUsageRevision ? (!$_htmlPending && (($_htmlPending = true) && @get(window.location.pathname + window.location.search, {retry: 'never'}).finally(() => $_htmlPending = false).catch(() => $_retrying = true))) : (!$_streamPending && (($_streamPending = true) && @get('/api/stream?revision=' + $_observedUsageRevision, {retry: 'never'}).finally(() => $_streamPending = false).catch(() => $_retrying = true))))" data-effect="$_observedUsageRevision > $_renderedUsageRevision && @peek(() => document.dispatchEvent(new CustomEvent('toktrak-dashboard-revision')))" data-on:toktrak-dashboard-revision__document="!$_authExpired && $_observedUsageRevision > $_renderedUsageRevision && !$_htmlPending && (($_htmlPending = true) && @get(window.location.pathname + window.location.search, {retry: 'never'}).finally(() => $_htmlPending = false).catch(() => $_retrying = true))" data-on:datastar-fetch__document="evt.detail.el.id === 'dashboard' && evt.detail.argsRaw.status === '401' ? (($_authExpired = true) && ($_retrying = false)) : (evt.detail.el.id === 'dashboard' && (evt.detail.type === 'retrying' || /^5\d\d$/u.test(evt.detail.argsRaw.status)) ? ($_retrying = true) : (evt.detail.el.id === 'dashboard' && evt.detail.type === 'datastar-patch-signals' && $_observedUsageRevision === $_renderedUsageRevision && ($_retrying = false)))">
    <p id="dashboard-refresh-state" data-show="$_authExpired || $_retrying" role="status"><span data-show="$_authExpired">Dashboard updates paused. Refresh to sign in again.</span><span data-show="!$_authExpired && $_retrying">Dashboard updates delayed. Retrying shortly.</span></p>
    <header class="page-heading">
      <h1>Visualizations</h1>
    </header>
{{#dashboard.degraded}}
    <aside class="warning" role="alert"><strong>Read-only mode</strong> Showing last stored usage.</aside>
{{/dashboard.degraded}}
{{#charts}}
    <section class="usage-range" aria-labelledby="range-heading">
      <div>
        <h2 id="range-heading" class="eyebrow">Range</h2>
        <p class="range-label"><strong>{{rangeLabel}}</strong> <span>{{calendarDays}} days · applies to every chart below</span></p>
      </div>
      <nav class="segmented" aria-label="Date range">
{{#rangeOptions}}
{{#current}}
        <a href="{{url}}" aria-current="page">{{label}}</a>
{{/current}}
{{^current}}
        <a href="{{url}}">{{label}}</a>
{{/current}}
{{/rangeOptions}}
      </nav>
      <form class="range-form" method="get" action="/visualizations">
        <input type="hidden" name="range" value="custom">
        <label>From <input type="date" name="from" value="{{rangeFrom}}" required></label>
        <label>To <input type="date" name="to" value="{{rangeTo}}" required></label>
        <button type="submit">Apply</button>
      </form>
    </section>
    <dl class="chart-kpis">
{{#kpis}}
      <div><dt>{{label}}</dt><dd data-usd="{{usd}}">{{value}}</dd></div>
{{/kpis}}
    </dl>
    <div class="chart-grid">
{{#dailyCost}}
      <article class="chart-card chart-card-wide" aria-labelledby="daily-cost-heading">
        <h2 id="daily-cost-heading">Cost per {{bucketName}} by tool</h2>
        <p>{{description}}</p>
        <svg class="chart" viewBox="0 0 {{width}} {{height}}" role="img" aria-labelledby="daily-cost-heading">
{{#yTicks}}
          <line class="chart-grid-line" x1="{{x1}}" y1="{{y}}" x2="{{x2}}" y2="{{y}}"/>
          <text class="chart-axis" x="{{labelX}}" y="{{labelY}}" text-anchor="end">{{label}}</text>
{{/yTicks}}
{{#columns}}
          <rect class="{{seriesClass}}" x="{{x}}" y="{{y}}" width="{{width}}" height="{{height}}" data-usd="{{usd}}"><title>{{title}}</title></rect>
{{/columns}}
{{#averages}}
          <path class="chart-average" d="{{path}}"><title>{{label}}</title></path>
{{/averages}}
{{#xLabels}}
          <text class="chart-axis" x="{{x}}" y="{{y}}" text-anchor="middle">{{label}}</text>
{{/xLabels}}
        </svg>
        <ul class="chart-legend">
{{#legend}}
          <li data-usd="{{usd}}"><span class="swatch {{seriesClass}}" aria-hidden="true"></span>{{label}} <strong>{{value}}</strong></li>
{{/legend}}
{{#averages}}
          <li><span class="swatch swatch-line" aria-hidden="true"></span>{{label}}</li>
{{/averages}}
        </ul>
        <dl class="chart-stats">
{{#stats}}
          <div><dt>{{label}}</dt><dd data-usd="{{usd}}">{{value}}</dd></div>
{{/stats}}
        </dl>
        <details class="chart-data">
          <summary>Data table</summary>
          <div class="table-wrap">
            <table>
              <thead><tr><th scope="col">Period</th><th scope="col">Estimated cost</th></tr></thead>
              <tbody>
{{#rows}}
                <tr data-usd="{{usd}}"><td>{{bucket}}</td><td>{{value}}</td></tr>
{{/rows}}
              </tbody>
            </table>
          </div>
        </details>
        <p class="chart-note">Tool totals add up to the estimated cost above. Costs without a reported tool appear as Not reported.</p>
      </article>
{{/dailyCost}}
    </div>
{{/charts}}
    <h2 class="legacy-heading">All reported dates · older views</h2>
    <div class="narrative">
      <section class="viz-section viz-hero" aria-labelledby="trend-heading">
        <div>
          <h2 id="trend-heading">Daily projected cost</h2>
          <p>Recent daily totals across the team. USD remains canonical; the selected currency is an estimate.</p>
        </div>
        <figure class="trend-chart">
          <svg class="chart-rule" viewBox="0 0 100 2" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 1H100"/></svg>
          <figcaption class="sr-only">Daily cost trend shown as proportional text bars.</figcaption>
{{#dashboard.trends}}
          <div class="trend-row">
            <time datetime="{{date}}">{{humanReadableDate}}</time>
            <span class="bar" aria-hidden="true">{{bar}}</span>
            <strong>{{cost}}</strong>
            <small>{{tokens}} tokens</small>
          </div>
{{/dashboard.trends}}
{{^dashboard.trends}}
          <p class="empty">No daily usage yet.</p>
{{/dashboard.trends}}
        </figure>
      </section>

      <section class="viz-section" aria-labelledby="tokens-heading">
        <div>
          <h2 id="tokens-heading">Where tokens go</h2>
        </div>
        <div class="metric-list">
{{#dashboard.tokenTypes}}
          <div class="metric-row"><strong>{{label}}</strong><span class="bar" aria-hidden="true">{{bar}}</span><span>{{value}}</span><small>{{detail}}</small></div>
{{/dashboard.tokenTypes}}
        </div>
      </section>

      <section class="viz-section" aria-labelledby="rhythm-heading">
        <div>
          <h2 id="rhythm-heading">Usage by day of the week</h2>
          <p>Adds up estimated cost and tokens across all reported dates and tools. Weekdays use the dates reported by each tracker. The longest bar marks the highest total cost.</p>
        </div>
        <div class="rhythm-grid" role="list">
{{#dashboard.rhythm}}
          <div role="listitem"><strong>{{label}}</strong><span class="heat" aria-hidden="true">{{bar}}</span><span>{{value}}</span><small>{{detail}}</small></div>
{{/dashboard.rhythm}}
        </div>
      </section>

      <section class="viz-section split" aria-labelledby="mix-heading">
        <div>
          <h2 id="mix-heading">Model and harness mix</h2>
        </div>
        <article>
          <h3>Models</h3>
          <div class="metric-list compact">
{{#dashboard.models}}
            <div class="metric-row"><strong>{{label}}</strong><span class="bar" aria-hidden="true">{{bar}}</span><span>{{value}}</span><small>{{detail}}</small></div>
{{/dashboard.models}}
          </div>
        </article>
        <article>
          <h3>Sources</h3>
          <div class="metric-list compact">
{{#dashboard.sources}}
            <div class="metric-row"><strong>{{label}}</strong><span class="bar" aria-hidden="true">{{bar}}</span><span>{{value}}</span><small>{{detail}}</small></div>
{{/dashboard.sources}}
          </div>
        </article>
      </section>

      <section class="viz-section" aria-labelledby="streams-heading">
        <div>
          <h2 id="streams-heading">Individual streams, shared context</h2>
        </div>
        <ol class="leaderboard streams">
{{#dashboard.userStreams}}
          <li><span class="avatar {{colorClass}}" aria-hidden="true">{{initials}}</span><span class="person"><strong>{{name}}</strong><span class="bar" aria-hidden="true">{{bar}}</span></span><span class="values"><strong>{{cost}}</strong><small>{{tokens}}</small></span></li>
{{/dashboard.userStreams}}
        </ol>
        <div class="table-wrap">
          <table>
            <caption>Largest individual daily cost rows</caption>
            <thead><tr><th>Date</th><th>User</th><th>Cost</th><th>Tokens</th></tr></thead>
            <tbody>
{{#dashboard.spikes}}
              <tr><td><time datetime="{{date}}">{{humanReadableDate}}</time></td><td>{{user}}</td><td>{{cost}}</td><td>{{tokens}}</td></tr>
{{/dashboard.spikes}}
            </tbody>
          </table>
        </div>
      </section>

      <section class="viz-section" aria-labelledby="details-heading">
        <div>
          <h2 id="details-heading">Costliest sessions</h2>
          <p>Harness is always shown. Project appears when ccusage reports it.</p>
        </div>
        <div class="table-wrap">
          <table>
            <caption>Top sessions by projected cost</caption>
            <thead><tr><th>User</th><th>Source</th><th>Project</th><th>Models</th><th>Cost</th><th>Tokens</th><th>Last activity</th></tr></thead>
            <tbody>
{{#dashboard.sessions}}
              <tr><td>{{user}}</td><td>{{source}}</td><td>{{project}}</td><td>{{models}}</td><td>{{cost}}</td><td>{{tokens}}</td><td>{{lastActivity}}</td></tr>
{{/dashboard.sessions}}
            </tbody>
          </table>
        </div>
      </section>

      <section class="viz-section" aria-labelledby="blocks-heading">
        <div>
          <h2 id="blocks-heading">Recent usage windows</h2>
          <p>These five-hour windows come from ccusage. They show recorded usage, not time spent coding.</p>
        </div>
        <div class="table-wrap">
          <table>
            <caption>Up to 20 windows, newest first</caption>
            <thead><tr><th>Start UTC</th><th>Models</th><th>Cost</th><th>Tokens</th><th>Entries</th></tr></thead>
            <tbody>
{{#dashboard.blocks}}
              <tr><td>{{start}}</td><td>{{models}}</td><td>{{cost}}</td><td>{{tokens}}</td><td>{{entries}}</td></tr>
{{/dashboard.blocks}}
            </tbody>
          </table>
        </div>
      </section>
    </div>
    <footer class="page-footer"><p>Totals are projected subscription-equivalent usage, not invoices or performance measures.</p><a href="/scope">Read data scope →</a></footer>
  </div>
{{/content}}
{{/base.mustache}}
