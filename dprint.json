{
  "lineWidth": 80,
  "excludes": [
    "sources/toktrak/assets/public/datastar.js",
    "**/*.d2",
    "**/*.svg",
    "**/*.mustache"
  ],
  "biome": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "markdown": {
    "textWrap": "always"
  },
  "dockerfile": {
    "associations": [
      "Containerfile"
    ]
  },
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "google-java-format -",
        "exts": [
          "java"
        ],
        "cacheKeyFiles": [
          "mise.lock"
        ]
      }
    ]
  },
