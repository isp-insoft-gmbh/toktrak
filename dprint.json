{
  "lineWidth": 80,
  "excludes": [
    "sources/toktrak/assets/public/datastar.js",
    "**/*.d2",
    "**/*.svg",
    "**/*.mustache"
  ],
  "biome": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "markdown": {
    "textWrap": "always"
  },
  "dockerfile": {
    "associations": [
      "Containerfile"
    ]
  },
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "google-java-format -",
        "exts": [
          "java"
        ],
        "cacheKeyFiles": [
          "mise.lock"
        ]
      }
    ]
  },
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.29.0.wasm@714aea7555dd9831861be466da8b26b2d92316d3cde550ef3e1f63b31f4ea302",
    "https://plugins.dprint.dev/biome-0.15.5.wasm@398a93c95a0ea1558ee31868b923721f000613b47cfa4d268c6c1154288b7eee",
    "https://plugins.dprint.dev/exec-0.9.0.json@939c28cce4022e2676ac9596585448c16abee12b8ccb0320a9eb9596ade1c219",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm@40a2fdda7040317eb1b23520f3a00769a5571eedb049c4ca9175c1b9eeba01ae",
    "https://plugins.dprint.dev/toml-0.10.0.wasm@0a8af7f5fe70c7ec652d77198867b2a97a1e690d5f3697542c603610aa47d3b3",
    "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm@1c1b31f972ef5aae052f97b6723aaf962e0175c5bbe4ba877e092512af354113",
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.6.wasm@93dd0c870b60431ceea59f055792fee4a353868223c813d3a44414b31d1df602",
    "https://plugins.dprint.dev/dockerfile-0.8.0.wasm@6de480ddc970b63d6b2abb5f5eef9968c027669757967bf3688858c98a2fc84c"
  ]
}
